<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Dexterity FTI"
        name="DummyContent"
        i18n:domain="plone.exportimport"
>

  <!-- Basic properties -->
  <property name="title"
            i18n:translate=""
  >Dummy</property>
  <property name="description"
            i18n:translate=""
  >Dummy content</property>

  <property name="allow_discussion">True</property>
  <property name="factory">DummyContent</property>

  <!-- Hierarchy control -->
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="Image" />
  </property>
  <property name="global_allow">True</property>

  <!-- Schema, class and security -->
  <property name="add_permission">plone.exportimport.testing.dummy.add</property>
  <property name="klass">plone.exportimport.testing.content.dummy.DummyContent</property>
  <property name="schema">plone.exportimport.testing.content.dummy.IDummyContent</property>

  <!-- Enabled behaviors -->
  <property name="behaviors"
            purge="true"
  >
    <element value="plone.basic" />
    <element value="plone.namefromtitle" />
    <element value="volto.blocks" />
    <element value="volto.preview_image" />
    <element value="plone.categorization" />
    <element value="volto.navtitle" />
    <element value="plone.excludefromnavigation" />
    <element value="plone.shortname" />
  </property>

  <!-- View information -->
  <property name="add_view_expr">string:${folder_url}/++add++DummyContent</property>
  <property name="immediate_view">view</property>
  <property name="default_view">view</property>
  <property name="default_view_fallback">False</property>
  <property name="view_methods">
    <element value="view" />
  </property>
</object>
